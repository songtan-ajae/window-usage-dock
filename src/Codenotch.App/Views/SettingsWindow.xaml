<Window x:Class="Codenotch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Usage Dock 환경설정" Height="750" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Foreground="#F2F6FC">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#26394B" Offset="0" />
            <GradientStop Color="#1B2735" Offset="0.48" />
            <GradientStop Color="#141C28" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="DockCheckBox" TargetType="CheckBox">
            <Setter Property="Background" Value="#643A4B60" />
            <Setter Property="BorderBrush" Value="#68859CB7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#E4E8EF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckRow" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckSurface" Width="18" Height="18" CornerRadius="4"
                                        Background="#232731" BorderBrush="#667085" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="White"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckRow" Property="BorderBrush" Value="#9BB9D4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#65445D78" />
            <Setter Property="Foreground" Value="#F2F7FF" />
            <Setter Property="BorderBrush" Value="#799CB8D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#79557291" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#A7C3DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#3D5875" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Primary">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#3976DB" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#76AAFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#4D8AF0" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvisiblePageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="#354353" CornerRadius="5" Margin="2,0" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisiblePageButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#829BB5" CornerRadius="4" Margin="2,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisiblePageButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Windows Usage Dock" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <Border Background="#4B455C75" BorderBrush="#567D9ABC" BorderThickness="1"
                        CornerRadius="5" Margin="10,0,0,0" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock Text="에이전트 선택" FontSize="11" Foreground="#C6D9EF" />
                </Border>
            </StackPanel>
            <TextBlock Text="화면 오른쪽에서 AI 어시스턴트 사용량과 세션 상태를 확인합니다."
                       FontSize="11.5" Foreground="#B8C8DA" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Background="Transparent">
            <StackPanel Margin="0,0,8,0">
                <Border BorderBrush="#69879FB9" BorderThickness="1" CornerRadius="12"
                        Margin="0,0,0,8" Padding="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A735485E" Offset="0" />
                            <GradientStop Color="#77303D50" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="일반 설정" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#D8E7F8" Margin="0,0,0,9" />
                        <CheckBox x:Name="ChkAlwaysShow" Style="{StaticResource DockCheckBox}" Margin="0,0,0,7">
                            <TextBlock Text="위젯 항상 펼쳐두기 (마우스가 벗어나도 유지)" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="ChkAlerts" Style="{StaticResource DockCheckBox}" Margin="0,0,0,11">
                            <TextBlock Text="사용량이 80% 또는 100%에 도달하면 알림 받기" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button x:Name="BtnResetPos" Content="위젯 위치 초기화 · 화면 오른쪽 가운데"
                                Style="{StaticResource GlassButton}" HorizontalAlignment="Left"
                                Click="BtnResetPos_Click" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="#69879FB9" BorderThickness="1" CornerRadius="12" Padding="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A735485E" Offset="0" />
                            <GradientStop Color="#77303D50" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="독에 표시할 AI 에이전트" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#D8E7F8" Margin="0,0,0,4" />
                        <TextBlock Text="최대 5개를 선택할 수 있습니다. 선택하지 않은 에이전트는 독에 표시되지 않습니다."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#AFC1D6" Margin="0,0,0,9" />
                        <StackPanel x:Name="ProviderSelectionPanel" />
                        <TextBlock x:Name="TxtProviderSelectionStatus" FontSize="11"
                                   Foreground="#8DC5FF" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,13,0,0">
            <Border Height="1" VerticalAlignment="Top" Background="#557D9BB8" />
            <TextBlock Text="Windows Usage Dock" FontSize="11" Foreground="#AFC1D6"
                       VerticalAlignment="Center" Margin="0,12,0,0" />
            <Button Content="완료" Tag="Primary" Width="88" Height="36" HorizontalAlignment="Right"
                    Style="{StaticResource GlassButton}" Margin="0,12,0,0" Click="BtnDone_Click" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="Codenotch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Usage Dock 환경설정" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F0F12" Foreground="#EEEEEE">
    <Window.Resources>
        <Style x:Key="DockCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E8EF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckSurface" Width="18" Height="18" CornerRadius="4"
                                        Background="#232731" BorderBrush="#667085" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="White"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Windows Usage Dock" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                <Border Background="#1C1C22" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="에이전트 선택" FontSize="11" Foreground="#A1A1AA" />
                </Border>
            </StackPanel>
            <TextBlock Text="화면 우측 가장자리에서 AI 어시스턴트 사용량 및 세션을 실시간 모니터링합니다." 
                       FontSize="11.5" Foreground="#A6ADBA" Margin="0,4,0,0" />
            <Separator Background="#222228" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Body Options & Providers -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <TextBlock Text="일반 설정" FontSize="11.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,8" />
                
                <CheckBox x:Name="ChkAlwaysShow" Content="노치 항상 펼쳐두기 (마우스가 벗어나도 닫히지 않음)" 
                          Style="{StaticResource DockCheckBox}" Margin="0,5" />
                <CheckBox x:Name="ChkAlerts" Content="사용량이 80% 및 100%에 도달했을 때 윈도우 알림 받기" 
                          Style="{StaticResource DockCheckBox}" Margin="0,5" />
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                    <Button x:Name="BtnResetPos" Content="노치 위치를 화면 우측 세로 중앙으로 재정렬" Background="#252A33" Foreground="#E4E4E7"
                            Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnResetPos_Click" />
                </StackPanel>

                <TextBlock Text="독에 표시할 AI 에이전트" FontSize="11.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,4,0,3" />
                <TextBlock Text="최대 5개를 선택할 수 있습니다. 선택하지 않은 에이전트는 실행 중이어도 독에 표시되지 않습니다."
                           TextWrapping="Wrap" FontSize="10.5" Foreground="#A6ADBA" Margin="0,0,0,8" />
                <Border Background="#121217" BorderBrush="#27272F" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <StackPanel x:Name="ProviderSelectionPanel" />
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="TxtProviderSelectionStatus" FontSize="10.5" Foreground="#60A5FA" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Windows Usage Dock" FontSize="11" Foreground="#8993A3" VerticalAlignment="Center" />
            <Button Content="완료" Width="80" Height="32" HorizontalAlignment="Right" Background="#3B82F6" Foreground="#FFFFFF"
                    BorderThickness="0" Cursor="Hand" Click="BtnDone_Click" />
        </Grid>
    </Grid>
</Window>

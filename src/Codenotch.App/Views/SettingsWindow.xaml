<Window x:Class="Codenotch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codenotch 환경설정" Height="430" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F0F12" Foreground="#EEEEEE">
    
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Codenotch" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                <Border Background="#1C1C22" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="1.8.0 Windows 에디션" FontSize="11" Foreground="#A1A1AA" />
                </Border>
            </StackPanel>
            <TextBlock Text="화면 우측 가장자리에서 AI 어시스턴트 사용량 및 세션을 실시간 모니터링합니다." 
                       FontSize="11.5" Foreground="#71717A" Margin="0,4,0,0" />
            <Separator Background="#222228" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Body Options & Providers -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <TextBlock Text="일반 설정" FontSize="11.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,8" />
                
                <CheckBox x:Name="ChkAlwaysShow" Content="노치 항상 펼쳐두기 (마우스가 벗어나도 닫히지 않음)" 
                          Foreground="#E4E4E7" Margin="0,5" />
                <CheckBox x:Name="ChkAlerts" Content="사용량이 80% 및 100%에 도달했을 때 윈도우 알림 받기" 
                          IsChecked="True" Foreground="#E4E4E7" Margin="0,5" />
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                    <Button x:Name="BtnResetPos" Content="📍 노치 위치를 화면 우측 세로 중앙으로 재정렬" Background="#1C1C22" Foreground="#E4E4E7"
                            Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnResetPos_Click" />
                </StackPanel>

                <!-- Providers List -->
                <TextBlock Text="모니터링 중인 AI 어시스턴트 (코덱스 / 안티그래비티 / 클로드)" FontSize="11.5" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,4,0,8" />
                <ItemsControl x:Name="ListProviders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16161B" BorderBrush="#25252D" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" Background="#22222C" CornerRadius="14" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding PrimaryStatusText}" FontSize="10.5" Foreground="#A1A1AA" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ResetTimeText}" FontSize="10.5" Foreground="#71717A" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Codenotch for Windows" FontSize="11" Foreground="#52525B" VerticalAlignment="Center" />
            <Button Content="완료" Width="75" Height="28" HorizontalAlignment="Right" Background="#3B82F6" Foreground="#FFFFFF"
                    BorderThickness="0" Cursor="Hand" Click="BtnDone_Click" />
        </Grid>
    </Grid>
</Window>

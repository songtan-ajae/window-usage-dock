<Window x:Class="Codenotch.App.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Codenotch.App.Controls"
        mc:Ignorable="d"
        Title="Windows Usage Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="40" Height="136">

    <Window.Resources>
        <Style x:Key="DockActionButton" TargetType="Button">
            <Setter Property="Background" Value="#292D36" />
            <Setter Property="Foreground" Value="#E8EBF0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#39404D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#465163" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F02B2B30" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#2F2F38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <!-- Outer Window Container (Right-edge docked) -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
        <!-- Physical Notch Body: Right flush (flat), Left rounded (16, 0, 0, 16) -->
        <Border x:Name="NotchBody" Background="#FA1B1D23" BorderBrush="#42FFFFFF" BorderThickness="1,1,0,1"
                CornerRadius="16,0,0,16" SnapsToDevicePixels="True" Cursor="SizeNS">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.22" ShadowDepth="2" Direction="180" />
            </Border.Effect>

            <Grid>
                <!-- COMPACT VIEW: 우측 벽에 세로로 정렬된 3개 링 -->
                <Grid x:Name="CompactView" Width="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="VerticalRingsPanel" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                </Grid>

                <!-- EXPANDED DRAWER: 5시간 제한과 주간 제한을 전부 다 함께 보여주는 상세 서랍 -->
                <Grid x:Name="ExpandedContent" Width="380" Visibility="Collapsed" Opacity="0"
                      RenderTransformOrigin="1,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedScale" ScaleX="0.96" ScaleY="0.96" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Full Details Panel -->
                    <Grid Grid.Column="0" Margin="16,14,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Agent Title & Badge -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtDetailName" Text="코덱스" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                            <Border x:Name="BadgePlan" Background="#10A37F" CornerRadius="4" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgePlan" Text="ChatGPT Plus" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>

                        <!-- 5시간 제한 & 주간 제한 전부 다 보여주는 영역 -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,6">
                            <!-- 1. 5시간 사용 제한 섹션 -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPrimaryLabel" Text="5시간 사용 제한" FontSize="11" FontWeight="SemiBold" Foreground="#E0E4EB" />
                                <TextBlock x:Name="TxtPrimaryReset" Grid.Column="1" Text="2시간 40분 후 갱신" FontSize="11" Foreground="#B8C0CC" />
                            </Grid>
                            <Grid x:Name="PrimaryBarContainer" Height="5.5" SnapsToDevicePixels="True" Margin="0,2,0,3">
                                <Border Background="#1E1E26" CornerRadius="3" />
                                <Border x:Name="PrimaryBarFill" Background="#10A37F" CornerRadius="3" HorizontalAlignment="Left" Width="100" />
                            </Grid>
                            <TextBlock x:Name="TxtPrimaryUsage" Text="33% 남음 · 67% 사용됨" FontSize="11" Foreground="#C5CBD5" Margin="0,0,0,8" />

                            <!-- 2. 주간 사용 제한 섹션 (함께 전부 다 표시!) -->
                            <Grid x:Name="SecondarySection" Margin="0,0,0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSecondaryLabel" Text="주간 사용 제한" FontSize="11" FontWeight="SemiBold" Foreground="#E0E4EB" />
                                    <TextBlock x:Name="TxtSecondaryReset" Grid.Column="1" Text="4일 후 갱신" FontSize="11" Foreground="#B8C0CC" />
                                </Grid>
                                <Grid x:Name="SecondaryBarContainer" Grid.Row="1" Height="5.5" SnapsToDevicePixels="True" Margin="0,2,0,3">
                                    <Border Background="#1E1E26" CornerRadius="3" />
                                    <Border x:Name="SecondaryBarFill" Background="#10A37F" CornerRadius="3" HorizontalAlignment="Left" Width="120" />
                                </Grid>
                                <TextBlock x:Name="TxtSecondaryUsage" Grid.Row="2" Text="57% 남음 · 43% 사용됨" FontSize="11" Foreground="#C5CBD5" />
                            </Grid>
                        </StackPanel>

                        <!-- Bottom Action Buttons -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtLastUpdated" Text="방금 갱신됨" FontSize="10.5" Foreground="#B8C0CC" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnRefresh" Content="새로고침" Style="{StaticResource DockActionButton}"
                                        ToolTip="지금 바로 새로고침" Click="BtnRefresh_Click" />
                                <Button x:Name="BtnPin" Content="고정" Style="{StaticResource DockActionButton}"
                                        ToolTip="노치 항상 펼쳐두기" Click="BtnPin_Click" />
                                <Button x:Name="BtnSettings" Content="설정" Style="{StaticResource DockActionButton}"
                                        ToolTip="환경설정 열기" Click="BtnSettings_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1" Background="#1C1C24" Margin="0,10" />

                    <!-- Right: Vertical Rings inside expanded view -->
                    <StackPanel x:Name="ExpandedRingsPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
